# Google Sheet published as CSV containing guest list.
# Sheet -> File -> Share -> Publish to web -> select sheet -> CSV.
# Columns required: slug, name  (extra columns ignored)
VITE_GUEST_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQd2GshypKHTdJVWPEUXTmMhW4AFsRbIM-y24H6CUS8694F7n8w7KtyYnr_EUMUPTv9-6cTR1KMFU_G/pub?output=csv

# Google Apps Script Web App URL that appends RSVP rows to a Sheet.
# See apps-script/rsvp.gs for the script to deploy.
VITE_RSVP_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXX/exec

# All wedding content (couple names, date, venue, story text, photos, RSVP
# copy) now lives in src/data.json — edit that file directly, no env vars
# needed for content.
